from pathlib import Path
parent = Node(disableipv6=1)
# By default, Authorities are not configured as exits
Authority = parent.specialize(tag="a", authority=1, relay=1)

# Let authorities bootstrap before trying to bring up more
parent.launch_phase += 1

ExitRelay = parent.specialize(tag="r", relay=1, exit=1)
Client = parent.specialize(tag="c", client=1)

BridgeAuthority = parent.specialize(tag="ba", authority=1, bridgeauthority=1, relay=1)
Bridge = parent.specialize(
    tag="br",
    bridge=1,
    pt_bridge=1,
    relay=1,
    pt_transport="pqobfs",
    pt_executable=Path("/usr/local/bin/lyrebird"),
    # incompatible with pt_transport
    sandbox=0,
)

parent.launch_phase += 1

BridgeClient = parent.specialize(
    tag="bc",
    client=1,
    bridgeclient=1,
    pt_transport="pqobfs",
    pt_executable=Path("/usr/local/bin/lyrebird"),
    # incompatible with pt_transport
    sandbox=0,
)

NODES = (
    Authority.getN(4)
    + BridgeAuthority.getN(1)
    + ExitRelay.getN(4)
    + Bridge.getN(1)
    + Client.getN(1)
    + BridgeClient.getN(1)
)

ConfigureNodes(NODES)
